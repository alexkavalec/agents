POLYGON_WALLET_PRIVATE_KEY=""

# Optional — Polymarket CLOB API credentials (derived automatically if not set)
CLOB_API_KEY=""
CLOB_API_SECRET=""
CLOB_API_PASSPHRASE=""


# Optional — Polygon RPC (defaults to public Alchemy demo endpoint)
POLYGON_FUNDER_ADDRESS=""
POLYGON_RPC_URL=""

# Optional — Discord webhook for trade/guardrail notifications
DISCORD_WEBHOOK_URL=""

# Optional but recommended — protects the stats dashboard (balance, positions,
# trade history) with a shared-secret query param: https://your-app/?key=...
# If unset, the dashboard is publicly readable to anyone with the URL.
DASHBOARD_TOKEN=""

# Optional but recommended on Railway — directory for the bot's state files
# (trade_history.json, trader_trade_history.json, whale_positions_state.json,
# whale_scan_cache.json, bot_overrides.json). Point this at a mounted Railway
# Volume (e.g. "/data") so trade history and dedup state survive redeploys
# instead of resetting on every deploy. Defaults to the working directory
# (not persisted). See CLAUDE.md's "Persistent state" notes for the Railway
# setup steps.
DATA_DIR=""

# Required for the dashboard's chat box (agents/application/chat.py) — lets you
# type things like "copy only tony today" or "cap 10 trades today, $20 each"
# to adjust today's mechanical trading rules. Get a key at console.anthropic.com.
# If unset, the chat box replies that it isn't configured; the bot itself is
# unaffected either way.
ANTHROPIC_API_KEY=""
