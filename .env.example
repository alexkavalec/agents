POLYGON_WALLET_PRIVATE_KEY=""

# Optional — Polymarket CLOB API credentials (derived automatically if not set)
CLOB_API_KEY=""
CLOB_API_SECRET=""
CLOB_API_PASSPHRASE=""


# Optional — Polygon RPC (defaults to public Alchemy demo endpoint)
POLYGON_FUNDER_ADDRESS=""
POLYGON_RPC_URL=""

# Optional — Discord webhook for trade/guardrail notifications
DISCORD_WEBHOOK_URL=""

# Optional but recommended — protects the stats dashboard (balance, positions,
# trade history) with a shared-secret query param: https://your-app/?key=...
# If unset, the dashboard is publicly readable to anyone with the URL.
DASHBOARD_TOKEN=""
